<routes>
    <vType id="ego_type" accel="5.4" decel="5.4" maxSpeed="13.89" color="1,0,0" vClass="passenger" guiShape="passenger/sedan"/>
    <vTypeDistribution id="carDist">
        <vType id="car_krauss" probability="0.3500" carFollowModel="Krauss" accel="2.0" decel="4.5" tau="1.0" minGap="2.5" maxSpeed="11.5" speedDev="0.15" color="1,1,0" vClass="passenger" guiShape="passenger/sedan" sigma="0.3" lcStrategic="0" lcCooperative="0" lcSpeedGain="0" lcKeepRight="0"/>
        <vType id="car_idm" probability="0.3000" carFollowModel="IDM" accel="1.8" decel="3.5" tau="1.2" minGap="2.0" maxSpeed="12.5" speedDev="0.1" color="0,1,1" vClass="passenger" guiShape="passenger/sedan" lcStrategic="0" lcCooperative="0" lcSpeedGain="0" lcKeepRight="0"/>
        <vType id="car_eidm" probability="0.2000" carFollowModel="EIDM" accel="2.0" decel="4.0" tau="1.1" minGap="2.0" maxSpeed="13.0" speedDev="0.1" color="1,0.6,0" vClass="passenger" guiShape="passenger/sedan" lcStrategic="0" lcCooperative="0" lcSpeedGain="0" lcKeepRight="0"/>
        <vType id="car_acc" probability="0.1500" carFollowModel="ACC" accel="2.0" decel="4.0" tau="1.5" minGap="2.0" maxSpeed="13.89" speedDev="0.05" color="1,0,1" vClass="passenger" guiShape="passenger/sedan" lcStrategic="0" lcCooperative="0" lcSpeedGain="0" lcKeepRight="0"/>
    </vTypeDistribution>
    <vTypeDistribution id="carDistFree">
        <vType id="free_krauss" probability="0.3500" carFollowModel="Krauss" accel="2.0" decel="4.5" tau="1.0" minGap="2.5" maxSpeed="11.5" speedDev="0.15" color="1,1,0" vClass="passenger" guiShape="passenger/sedan" sigma="0.3"/>
        <vType id="free_idm" probability="0.3000" carFollowModel="IDM" accel="1.8" decel="3.5" tau="1.2" minGap="2.0" maxSpeed="12.5" speedDev="0.1" color="0,1,1" vClass="passenger" guiShape="passenger/sedan"/>
        <vType id="free_eidm" probability="0.2000" carFollowModel="EIDM" accel="2.0" decel="4.0" tau="1.1" minGap="2.0" maxSpeed="13.0" speedDev="0.1" color="1,0.6,0" vClass="passenger" guiShape="passenger/sedan"/>
        <vType id="free_acc" probability="0.1500" carFollowModel="ACC" accel="2.0" decel="4.0" tau="1.5" minGap="2.0" maxSpeed="13.89" speedDev="0.05" color="1,0,1" vClass="passenger" guiShape="passenger/sedan"/>
    </vTypeDistribution>
    <route id="r0" edges="e0 e0b e1"/>
    <flow id="traffic" type="carDist" route="r0" begin="0" end="100000"
          period="4.50"
          departLane="random" departSpeed="8.0"/>
    <route id="r_opp" edges="e1_r e1_rb e0_r"/>
    <flow id="opp" type="carDist" route="r_opp" begin="0" end="100000" period="6.00" departLane="random" departSpeed="8.0"/>
    <route id="r_er" edges="e0 e0b s_out"/>
    <flow id="main_er" type="carDistFree" route="r_er" begin="0" end="100000" period="60.00" departLane="best" departSpeed="8.0"/>
    <route id="r_el" edges="e0 e0b n_out"/>
    <flow id="main_el" type="carDistFree" route="r_el" begin="0" end="100000" period="60.00" departLane="best" departSpeed="8.0"/>
    <route id="r_wr" edges="e1_r e1_rb n_out"/>
    <flow id="main_wr" type="carDistFree" route="r_wr" begin="0" end="100000" period="60.00" departLane="best" departSpeed="8.0"/>
    <route id="r_wl" edges="e1_r e1_rb s_out"/>
    <flow id="main_wl" type="carDistFree" route="r_wl" begin="0" end="100000" period="60.00" departLane="best" departSpeed="8.0"/>
    <route id="r_ns" edges="n_in n_inb s_out"/>
    <flow id="side_ns" type="carDistFree" route="r_ns" begin="0" end="100000" period="54.00" departLane="best" departSpeed="8.0"/>
    <route id="r_sn" edges="s_in s_inb n_out"/>
    <flow id="side_sn" type="carDistFree" route="r_sn" begin="0" end="100000" period="54.00" departLane="best" departSpeed="8.0"/>
    <route id="r_ne" edges="n_in n_inb e1"/>
    <flow id="side_ne" type="carDistFree" route="r_ne" begin="0" end="100000" period="54.00" departLane="best" departSpeed="8.0"/>
    <route id="r_nw" edges="n_in n_inb e0_r"/>
    <flow id="side_nw" type="carDistFree" route="r_nw" begin="0" end="100000" period="54.00" departLane="best" departSpeed="8.0"/>
    <route id="r_se" edges="s_in s_inb e1"/>
    <flow id="side_se" type="carDistFree" route="r_se" begin="0" end="100000" period="54.00" departLane="best" departSpeed="8.0"/>
    <route id="r_sw" edges="s_in s_inb e0_r"/>
    <flow id="side_sw" type="carDistFree" route="r_sw" begin="0" end="100000" period="54.00" departLane="best" departSpeed="8.0"/>
    <route id="r_ego_right" edges="e0 e0b s_out"/>
    <vType id="ped" vClass="pedestrian" speed="1.3" color="0,0.4,1"/>
    <personFlow id="ped_ns" type="ped" begin="0" end="100000" period="12.00" departPos="random">
        <walk from="n_in" to="s_out" arrivalPos="random"/>
    </personFlow>
    <personFlow id="ped_sn" type="ped" begin="0" end="100000" period="12.00" departPos="random">
        <walk from="s_in" to="n_out" arrivalPos="random"/>
    </personFlow>
    <personFlow id="ped_we" type="ped" begin="0" end="100000" period="12.00" departPos="random">
        <walk from="e0b" to="e1" arrivalPos="random"/>
    </personFlow>
    <personFlow id="ped_ew" type="ped" begin="0" end="100000" period="12.00" departPos="random">
        <walk from="e1_rb" to="e0_r" arrivalPos="random"/>
    </personFlow>
</routes>
